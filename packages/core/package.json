{
	"name": "@bruneckel/theme-transitions-core",
	"version": "0.1.1",
	"description": "Framework-agnostic core for animated dark/light theme transitions using the View Transitions API",
	"author": "Bruno Neckel",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bruneckel/theme-transitions.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "unbuild",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"theme",
		"dark-mode",
		"view-transitions",
		"spread",
		"fade",
		"transition",
		"animation"
	]
}
