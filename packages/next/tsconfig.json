{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true,
		"jsx": "react-jsx",
		"noEmit": true
	},
	"include": ["src/**/*"]
}
