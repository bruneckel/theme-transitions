{
	"name": "theme-transitions",
	"private": true,
	"type": "module",
	"license": "MIT",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build --workspaces",
		"pretest": "npm run build --workspace=packages/core",
		"test": "vitest run",
		"lint": "eslint .",
		"pretypecheck": "npm run build --workspace=packages/core",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"dev:vue-demo": "npm run dev --workspace=apps/vue-demo",
		"dev:react-demo": "npm run dev --workspace=apps/react-demo",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "npm run build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.8.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"unbuild": "^3.6.0",
		"vitest": "^4.1.0"
	}
}
